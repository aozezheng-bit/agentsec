{
  "$defs": {
    "ManifestAssetFormat": {
      "description": "Normalized syntax of one Manifest source asset.",
      "enum": [
        "markdown",
        "rules",
        "json",
        "yaml",
        "toml"
      ],
      "title": "ManifestAssetFormat",
      "type": "string"
    },
    "ManifestAssetRole": {
      "description": "Normalized reason one source participates in the Manifest.",
      "enum": [
        "agent_instructions",
        "instruction_override",
        "skill",
        "prefix_rules",
        "framework_config",
        "mcp_config"
      ],
      "title": "ManifestAssetRole",
      "type": "string"
    },
    "ManifestAuthenticationKind": {
      "description": "Authentication mechanisms without credential values.",
      "enum": [
        "none",
        "api_key",
        "token",
        "oauth",
        "environment",
        "chatgpt",
        "unknown"
      ],
      "title": "ManifestAuthenticationKind",
      "type": "string"
    },
    "ManifestConfigurationCandidate": {
      "additionalProperties": false,
      "description": "One source-level configuration declaration awaiting precedence ordering.",
      "properties": {
        "chain_key": {
          "minLength": 1,
          "title": "Chain Key",
          "type": "string"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/ManifestConfigurationKind"
          },
          "title": "Kinds",
          "type": "array"
        },
        "precedence_rank": {
          "minimum": 0,
          "title": "Precedence Rank",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ManifestSourceReference"
        }
      },
      "required": [
        "source",
        "kinds",
        "precedence_rank",
        "chain_key"
      ],
      "title": "ManifestConfigurationCandidate",
      "type": "object"
    },
    "ManifestConfigurationKind": {
      "description": "Configuration families represented by one static source asset.",
      "enum": [
        "framework_config",
        "prefix_rules",
        "mcp_config"
      ],
      "title": "ManifestConfigurationKind",
      "type": "string"
    },
    "ManifestConfigurationProfile": {
      "additionalProperties": false,
      "description": "Source-level configuration precedence before field-level extraction.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestConfigurationCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "effective_order": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Effective Order",
          "type": "array"
        },
        "effective_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Effective Sources",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        },
        "resolution_trace": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestConfigurationResolutionStep"
          },
          "title": "Resolution Trace",
          "type": "array"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestConfigurationProfile",
      "type": "object"
    },
    "ManifestConfigurationResolutionAction": {
      "description": "Decision recorded for one configuration source.",
      "enum": [
        "selected",
        "conflict"
      ],
      "title": "ManifestConfigurationResolutionAction",
      "type": "string"
    },
    "ManifestConfigurationResolutionReason": {
      "description": "Safe explanation for one configuration source ordering decision.",
      "enum": [
        "user_scope",
        "project_root",
        "nested_project",
        "same_precedence",
        "incomplete_coverage"
      ],
      "title": "ManifestConfigurationResolutionReason",
      "type": "string"
    },
    "ManifestConfigurationResolutionStep": {
      "additionalProperties": false,
      "description": "One deterministic source-level configuration precedence decision.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ManifestConfigurationResolutionAction"
        },
        "chain_key": {
          "minLength": 1,
          "title": "Chain Key",
          "type": "string"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/ManifestConfigurationKind"
          },
          "title": "Kinds",
          "type": "array"
        },
        "precedence_rank": {
          "minimum": 0,
          "title": "Precedence Rank",
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/ManifestConfigurationResolutionReason"
        },
        "source": {
          "$ref": "#/$defs/ManifestSourceReference"
        }
      },
      "required": [
        "source",
        "kinds",
        "action",
        "reason",
        "precedence_rank",
        "chain_key"
      ],
      "title": "ManifestConfigurationResolutionStep",
      "type": "object"
    },
    "ManifestControl": {
      "additionalProperties": false,
      "description": "Normalized approval, sandbox, policy, or tool-control fact.",
      "properties": {
        "control_id": {
          "minLength": 1,
          "title": "Control Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ManifestControlKind"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ManifestControlState"
        },
        "target": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "control_id",
        "kind",
        "state",
        "sources"
      ],
      "title": "ManifestControl",
      "type": "object"
    },
    "ManifestControlKind": {
      "description": "Guardrail and policy controls represented in the Manifest.",
      "enum": [
        "human_approval",
        "sandbox",
        "prefix_rule",
        "trust",
        "tool_filter",
        "timeout",
        "network_policy",
        "secret_handling",
        "enablement",
        "required",
        "other"
      ],
      "title": "ManifestControlKind",
      "type": "string"
    },
    "ManifestControlProfile": {
      "additionalProperties": false,
      "description": "Control inventory and unresolved policy sources.",
      "properties": {
        "controls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestControl"
          },
          "title": "Controls",
          "type": "array"
        },
        "declaration_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Declaration Sources",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestControlProfile",
      "type": "object"
    },
    "ManifestControlState": {
      "description": "Normalized state of one Agent control.",
      "enum": [
        "enabled",
        "disabled",
        "required",
        "optional",
        "allow",
        "prompt",
        "deny",
        "configured",
        "unknown"
      ],
      "title": "ManifestControlState",
      "type": "string"
    },
    "ManifestCoverage": {
      "additionalProperties": false,
      "description": "Coverage counts for the source inventory represented by the Manifest.",
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "discovered_assets": {
          "minimum": 0,
          "title": "Discovered Assets",
          "type": "integer"
        },
        "inspected_assets": {
          "minimum": 0,
          "title": "Inspected Assets",
          "type": "integer"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestCoverageIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "skipped_assets": {
          "minimum": 0,
          "title": "Skipped Assets",
          "type": "integer"
        }
      },
      "required": [
        "discovered_assets",
        "inspected_assets",
        "skipped_assets",
        "complete"
      ],
      "title": "ManifestCoverage",
      "type": "object"
    },
    "ManifestCoverageIssue": {
      "additionalProperties": false,
      "description": "One framework-inspection gap retained without source or exception text.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ManifestCoverageIssueCode"
        },
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "root_id": {
          "minLength": 1,
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "root_id"
      ],
      "title": "ManifestCoverageIssue",
      "type": "object"
    },
    "ManifestCoverageIssueCode": {
      "description": "Stable source-coverage failures retained in an Agent Manifest.",
      "enum": [
        "unreadable",
        "unsupported_encoding",
        "too_large",
        "depth_exceeded",
        "asset_limit_exceeded",
        "external_symlink",
        "unsupported_format",
        "parse_error",
        "unknown"
      ],
      "title": "ManifestCoverageIssueCode",
      "type": "string"
    },
    "ManifestEnvironmentKind": {
      "description": "Operational environment associated with a runtime identity.",
      "enum": [
        "local",
        "development",
        "test",
        "staging",
        "production",
        "external",
        "unknown"
      ],
      "title": "ManifestEnvironmentKind",
      "type": "string"
    },
    "ManifestIdentity": {
      "additionalProperties": false,
      "description": "Stable local identity of the Agent subject represented by this Manifest.",
      "properties": {
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "declared_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Name"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "subject_root_id": {
          "minLength": 1,
          "title": "Subject Root Id",
          "type": "string"
        },
        "subject_scope": {
          "$ref": "#/$defs/ManifestSourceScope"
        }
      },
      "required": [
        "agent_id",
        "subject_scope",
        "subject_root_id",
        "resolution"
      ],
      "title": "ManifestIdentity",
      "type": "object"
    },
    "ManifestInstructionCandidate": {
      "additionalProperties": false,
      "description": "One base or Override instruction source awaiting effective resolution.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ManifestInstructionKind"
        },
        "precedence_rank": {
          "minimum": 0,
          "title": "Precedence Rank",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ManifestSourceReference"
        }
      },
      "required": [
        "kind",
        "source",
        "precedence_rank"
      ],
      "title": "ManifestInstructionCandidate",
      "type": "object"
    },
    "ManifestInstructionKind": {
      "description": "Instruction-source roles understood before inheritance resolution.",
      "enum": [
        "base",
        "override"
      ],
      "title": "ManifestInstructionKind",
      "type": "string"
    },
    "ManifestInstructionProfile": {
      "additionalProperties": false,
      "description": "Instruction candidates and later effective-source selection.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestInstructionCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "effective_order": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Effective Order",
          "type": "array"
        },
        "effective_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Effective Sources",
          "type": "array"
        },
        "overridden_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Overridden Sources",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        },
        "resolution_trace": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestInstructionResolutionStep"
          },
          "title": "Resolution Trace",
          "type": "array"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestInstructionProfile",
      "type": "object"
    },
    "ManifestInstructionResolutionAction": {
      "description": "Decision recorded for one instruction candidate.",
      "enum": [
        "selected",
        "overridden",
        "conflict"
      ],
      "title": "ManifestInstructionResolutionAction",
      "type": "string"
    },
    "ManifestInstructionResolutionReason": {
      "description": "Safe explanation for one instruction resolution decision.",
      "enum": [
        "only_candidate",
        "inherited",
        "override_replaces_base",
        "ambiguous_duplicate"
      ],
      "title": "ManifestInstructionResolutionReason",
      "type": "string"
    },
    "ManifestInstructionResolutionStep": {
      "additionalProperties": false,
      "description": "One deterministic decision made for one instruction candidate.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ManifestInstructionResolutionAction"
        },
        "chain_key": {
          "minLength": 1,
          "title": "Chain Key",
          "type": "string"
        },
        "precedence_rank": {
          "minimum": 0,
          "title": "Precedence Rank",
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/ManifestInstructionResolutionReason"
        },
        "source": {
          "$ref": "#/$defs/ManifestSourceReference"
        }
      },
      "required": [
        "source",
        "action",
        "reason",
        "precedence_rank",
        "chain_key"
      ],
      "title": "ManifestInstructionResolutionStep",
      "type": "object"
    },
    "ManifestMetadata": {
      "additionalProperties": false,
      "description": "Version and Adapter provenance for a reproducible Agent Manifest.",
      "properties": {
        "adapter_version": {
          "minLength": 1,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Adapter Version",
          "type": "string"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "framework_display_name": {
          "minLength": 1,
          "title": "Framework Display Name",
          "type": "string"
        },
        "framework_id": {
          "minLength": 1,
          "title": "Framework Id",
          "type": "string"
        },
        "scanner_version": {
          "minLength": 1,
          "title": "Scanner Version",
          "type": "string"
        }
      },
      "required": [
        "scanner_version",
        "framework_id",
        "framework_display_name",
        "adapter_version"
      ],
      "title": "ManifestMetadata",
      "type": "object"
    },
    "ManifestPermission": {
      "additionalProperties": false,
      "description": "Normalized permission fact populated by P2-09 and later.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ManifestPermissionAction"
        },
        "effect": {
          "$ref": "#/$defs/ManifestPermissionEffect"
        },
        "permission_id": {
          "minLength": 1,
          "title": "Permission Id",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ManifestResourceKind"
        },
        "scope": {
          "$ref": "#/$defs/ManifestResourceScope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "permission_id",
        "action",
        "effect",
        "resource",
        "scope",
        "sources"
      ],
      "title": "ManifestPermission",
      "type": "object"
    },
    "ManifestPermissionAction": {
      "description": "Normalized permission actions for an Agent capability profile.",
      "enum": [
        "read",
        "write",
        "execute",
        "network",
        "secret_access",
        "admin",
        "deploy",
        "publish",
        "delegate",
        "persist",
        "unknown"
      ],
      "title": "ManifestPermissionAction",
      "type": "string"
    },
    "ManifestPermissionEffect": {
      "description": "Decision applied to a normalized permission declaration.",
      "enum": [
        "allow",
        "prompt",
        "deny",
        "unknown"
      ],
      "title": "ManifestPermissionEffect",
      "type": "string"
    },
    "ManifestPermissionProfile": {
      "additionalProperties": false,
      "description": "Permission inventory and unresolved configuration sources.",
      "properties": {
        "declaration_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Declaration Sources",
          "type": "array"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestPermission"
          },
          "title": "Permissions",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestPermissionProfile",
      "type": "object"
    },
    "ManifestPrincipalKind": {
      "description": "Runtime principal families used by an Agent or tool.",
      "enum": [
        "user",
        "service_account",
        "api_client",
        "oauth_session",
        "chatgpt",
        "plugin",
        "anonymous",
        "unknown"
      ],
      "title": "ManifestPrincipalKind",
      "type": "string"
    },
    "ManifestRelation": {
      "additionalProperties": false,
      "description": "One Agent, Skill, MCP, tool, or memory relationship.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ManifestRelationKind"
        },
        "relation_id": {
          "minLength": 1,
          "title": "Relation Id",
          "type": "string"
        },
        "source_agent_id": {
          "minLength": 1,
          "title": "Source Agent Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ManifestRelationState"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "source_agent_id",
        "kind",
        "target_id",
        "state",
        "sources"
      ],
      "title": "ManifestRelation",
      "type": "object"
    },
    "ManifestRelationKind": {
      "description": "Agent, tool, Skill, MCP, and memory relationship families.",
      "enum": [
        "delegates_to",
        "uses_skill",
        "uses_mcp",
        "uses_tool",
        "reads_memory",
        "writes_memory",
        "persists_memory",
        "other"
      ],
      "title": "ManifestRelationKind",
      "type": "string"
    },
    "ManifestRelationState": {
      "description": "Resolution state of one normalized relationship.",
      "enum": [
        "declared",
        "active",
        "disabled",
        "unknown"
      ],
      "title": "ManifestRelationState",
      "type": "string"
    },
    "ManifestRelationshipProfile": {
      "additionalProperties": false,
      "description": "Sub-Agent, Skill, MCP, tool, and memory relationships.",
      "properties": {
        "declaration_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Declaration Sources",
          "type": "array"
        },
        "relations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestRelationshipProfile",
      "type": "object"
    },
    "ManifestResolutionStatus": {
      "description": "How completely one Manifest dimension has been deterministically resolved.",
      "enum": [
        "unresolved",
        "partial",
        "resolved",
        "unknown",
        "not_applicable",
        "conflict"
      ],
      "title": "ManifestResolutionStatus",
      "type": "string"
    },
    "ManifestResourceKind": {
      "description": "Resource families to which permissions or controls may apply.",
      "enum": [
        "filesystem",
        "repository",
        "shell",
        "network",
        "environment",
        "secret_store",
        "identity",
        "production",
        "tool",
        "memory",
        "other",
        "unknown"
      ],
      "title": "ManifestResourceKind",
      "type": "string"
    },
    "ManifestResourceScope": {
      "description": "Normalized operational scope for a permission or resource.",
      "enum": [
        "project",
        "user",
        "system",
        "external",
        "development",
        "test",
        "staging",
        "production",
        "unknown"
      ],
      "title": "ManifestResourceScope",
      "type": "string"
    },
    "ManifestRuntimeIdentity": {
      "additionalProperties": false,
      "description": "Credential-free runtime principal declaration populated by P2-09.",
      "properties": {
        "authentication": {
          "$ref": "#/$defs/ManifestAuthenticationKind"
        },
        "environment": {
          "$ref": "#/$defs/ManifestEnvironmentKind"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "principal_kind": {
          "$ref": "#/$defs/ManifestPrincipalKind"
        },
        "privileged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privileged"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "identity_id",
        "principal_kind",
        "authentication",
        "environment",
        "sources"
      ],
      "title": "ManifestRuntimeIdentity",
      "type": "object"
    },
    "ManifestRuntimeIdentityProfile": {
      "additionalProperties": false,
      "description": "Runtime identities and authentication declarations without secrets.",
      "properties": {
        "declaration_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Declaration Sources",
          "type": "array"
        },
        "identities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestRuntimeIdentity"
          },
          "title": "Identities",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestRuntimeIdentityProfile",
      "type": "object"
    },
    "ManifestSource": {
      "additionalProperties": false,
      "description": "One parsed framework asset represented without its untrusted content.",
      "properties": {
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ManifestAssetFormat"
        },
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "locator": {
          "$ref": "#/$defs/ManifestSourceLocator"
        },
        "precedence_rank": {
          "minimum": 0,
          "title": "Precedence Rank",
          "type": "integer"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/ManifestAssetRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "locator",
        "format",
        "roles",
        "content_sha256",
        "size_bytes",
        "line_count",
        "precedence_rank"
      ],
      "title": "ManifestSource",
      "type": "object"
    },
    "ManifestSourceLocator": {
      "additionalProperties": false,
      "description": "Portable locator for one source asset without an absolute host path.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "minLength": 1,
          "title": "Root Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ManifestSourceScope"
        }
      },
      "required": [
        "scope",
        "root_id",
        "path"
      ],
      "title": "ManifestSourceLocator",
      "type": "object"
    },
    "ManifestSourceReference": {
      "additionalProperties": false,
      "description": "Reference to a whole Manifest source or an exact field/line range.",
      "properties": {
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "field_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "locator": {
          "$ref": "#/$defs/ManifestSourceLocator"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "required": [
        "locator"
      ],
      "title": "ManifestSourceReference",
      "type": "object"
    },
    "ManifestSourceScope": {
      "description": "Portable trust scope for a Manifest source asset.",
      "enum": [
        "project",
        "user",
        "plugin"
      ],
      "title": "ManifestSourceScope",
      "type": "string"
    },
    "ManifestTool": {
      "additionalProperties": false,
      "description": "Normalized tool or capability declaration populated by P2-08 and later.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/ManifestToolAvailability"
        },
        "kind": {
          "$ref": "#/$defs/ManifestToolKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_tool_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Tool Id"
        },
        "side_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestToolSideEffect"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "tool_id": {
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "name",
        "kind",
        "availability",
        "sources"
      ],
      "title": "ManifestTool",
      "type": "object"
    },
    "ManifestToolAvailability": {
      "description": "Static availability state of a tool declaration.",
      "enum": [
        "declared",
        "enabled",
        "disabled",
        "unknown"
      ],
      "title": "ManifestToolAvailability",
      "type": "string"
    },
    "ManifestToolKind": {
      "description": "Normalized tool families available to later capability extraction.",
      "enum": [
        "skill",
        "mcp_server",
        "mcp_tool",
        "command",
        "builtin",
        "plugin",
        "other"
      ],
      "title": "ManifestToolKind",
      "type": "string"
    },
    "ManifestToolProfile": {
      "additionalProperties": false,
      "description": "Tool inventory plus source declarations awaiting association.",
      "properties": {
        "declaration_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Declaration Sources",
          "type": "array"
        },
        "resolution": {
          "$ref": "#/$defs/ManifestResolutionStatus"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestTool"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "resolution"
      ],
      "title": "ManifestToolProfile",
      "type": "object"
    },
    "ManifestToolSideEffect": {
      "description": "Potential side-effect families assigned by later deterministic analysis.",
      "enum": [
        "read",
        "write",
        "execute",
        "network",
        "destructive",
        "secret_access",
        "privileged",
        "unknown"
      ],
      "title": "ManifestToolSideEffect",
      "type": "string"
    },
    "ManifestUnknown": {
      "additionalProperties": false,
      "description": "One explicit unresolved fact without attacker-controlled explanation text.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ManifestUnknownDimension"
        },
        "field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "reason": {
          "$ref": "#/$defs/ManifestUnknownReason"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ManifestSourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "unknown_id": {
          "minLength": 1,
          "title": "Unknown Id",
          "type": "string"
        }
      },
      "required": [
        "unknown_id",
        "dimension",
        "reason"
      ],
      "title": "ManifestUnknown",
      "type": "object"
    },
    "ManifestUnknownDimension": {
      "description": "Manifest dimensions to which an explicit Unknown may belong.",
      "enum": [
        "identity",
        "instructions",
        "tools",
        "permissions",
        "controls",
        "runtime_identities",
        "relationships",
        "coverage"
      ],
      "title": "ManifestUnknownDimension",
      "type": "string"
    },
    "ManifestUnknownReason": {
      "description": "Stable reasons a Manifest fact cannot yet be resolved.",
      "enum": [
        "not_analyzed",
        "missing_source",
        "incomplete_coverage",
        "unsupported_field",
        "ambiguous_precedence",
        "conflicting_declarations",
        "runtime_verification_required"
      ],
      "title": "ManifestUnknownReason",
      "type": "string"
    }
  },
