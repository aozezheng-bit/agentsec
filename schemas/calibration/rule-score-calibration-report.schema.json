  "additionalProperties": false,
  "properties": {
    "calibration_generation": {
      "const": "v1",
      "default": "v1",
      "title": "Calibration Generation",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/CalibrationDecision"
    },
    "format": {
      "const": "agentsec-rule-score-calibration-report",
      "default": "agentsec-rule-score-calibration-report",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Format Version",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "pilot_evidence_mode": {
      "enum": [
        "internal_integration",
        "external_repository"
      ],
      "title": "Pilot Evidence Mode",
      "type": "string"
    },
    "pilot_id": {
      "title": "Pilot Id",
      "type": "string"
    },
    "pilot_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pilot Report Sha256",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleCalibrationResult"
      },
      "title": "Rules",
      "type": "array"
    },
    "scoring_replay": {
      "$ref": "#/$defs/ScoreReplayCalibration"
    },
    "status": {
      "enum": [
        "complete",
        "review_required",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/CalibrationSummary"
    }
  },
  "required": [
    "status",
    "pilot_id",
    "pilot_report_sha256",
    "pilot_evidence_mode",
    "summary",
    "decision",
    "rules",
    "scoring_replay",
    "limitations"
  ],
  "title": "RuleScoreCalibrationReport",
  "type": "object"
}
