    "CalibrationDecision": {
      "additionalProperties": false,
      "properties": {
        "candidate_risk_model_version": {
          "title": "Candidate Risk Model Version",
          "type": "string"
        },
        "candidate_rule_pack_version": {
          "title": "Candidate Rule Pack Version",
          "type": "string"
        },
        "current_risk_model_version": {
          "title": "Current Risk Model Version",
          "type": "string"
        },
        "current_rule_pack_version": {
          "title": "Current Rule Pack Version",
          "type": "string"
        },
        "external_calibration_required": {
          "const": true,
          "default": true,
          "title": "External Calibration Required",
          "type": "boolean"
        },
        "internal_mvp_ready": {
          "title": "Internal Mvp Ready",
          "type": "boolean"
        },
        "publish_rule_changes": {
          "const": false,
          "default": false,
          "title": "Publish Rule Changes",
          "type": "boolean"
        },
        "publish_score_changes": {
          "const": false,
          "default": false,
          "title": "Publish Score Changes",
          "type": "boolean"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "risk_model_action": {
          "enum": [
            "retain_current",
            "review_required"
          ],
          "title": "Risk Model Action",
          "type": "string"
        },
        "rule_pack_action": {
          "enum": [
            "retain_current",
            "review_required"
          ],
          "title": "Rule Pack Action",
          "type": "string"
        }
      },
      "required": [
        "current_rule_pack_version",
        "candidate_rule_pack_version",
        "current_risk_model_version",
        "candidate_risk_model_version",
        "rule_pack_action",
        "risk_model_action",
        "internal_mvp_ready",
        "rationale"
      ],
      "title": "CalibrationDecision",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "covered_rules": {
          "title": "Covered Rules",
          "type": "integer"
        },
        "more_data_rules": {
          "title": "More Data Rules",
          "type": "integer"
        },
        "pilot_cases": {
          "title": "Pilot Cases",
          "type": "integer"
        },
        "pilot_false_negatives": {
          "title": "Pilot False Negatives",
          "type": "integer"
        },
        "pilot_false_positives": {
          "title": "Pilot False Positives",
          "type": "integer"
        },
        "retain_current_rules": {
          "title": "Retain Current Rules",
          "type": "integer"
        },
        "review_false_negative_rules": {
          "title": "Review False Negative Rules",
          "type": "integer"
        },
        "review_false_positive_rules": {
          "title": "Review False Positive Rules",
          "type": "integer"
        },
        "scoring_replay_cases": {
          "title": "Scoring Replay Cases",
          "type": "integer"
        },
        "scoring_replay_verified": {
          "title": "Scoring Replay Verified",
          "type": "boolean"
        },
        "uncovered_rules": {
          "title": "Uncovered Rules",
          "type": "integer"
        }
      },
      "required": [
        "pilot_cases",
        "covered_rules",
        "uncovered_rules",
        "retain_current_rules",
        "more_data_rules",
        "review_false_positive_rules",
        "review_false_negative_rules",
        "pilot_false_positives",
        "pilot_false_negatives",
        "scoring_replay_cases",
        "scoring_replay_verified"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "RuleCalibrationRecommendation": {
      "enum": [
        "retain_current",
        "review_false_positive",
        "review_false_negative",
        "more_data"
      ],
      "title": "RuleCalibrationRecommendation",
      "type": "string"
    },
    "RuleCalibrationResult": {
      "additionalProperties": false,
      "properties": {
        "expected_positive_cases": {
          "title": "Expected Positive Cases",
          "type": "integer"
        },
        "false_negatives": {
          "title": "False Negatives",
          "type": "integer"
        },
        "false_positives": {
          "title": "False Positives",
          "type": "integer"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "likelihood": {
          "title": "Likelihood",
          "type": "string"
        },
        "observed_positive_cases": {
          "title": "Observed Positive Cases",
          "type": "integer"
        },
        "precision": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precision"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "recall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recall"
        },
        "recommendation": {
          "$ref": "#/$defs/RuleCalibrationRecommendation"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "true_positives": {
          "title": "True Positives",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "expected_positive_cases",
        "observed_positive_cases",
        "true_positives",
        "false_positives",
        "false_negatives",
        "precision",
        "recall",
        "likelihood",
        "impact",
        "score",
        "severity",
        "profile_sha256",
        "recommendation",
        "rationale"
      ],
      "title": "RuleCalibrationResult",
      "type": "object"
    },
