      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "cases": {
          "title": "Cases",
          "type": "integer"
        },
        "critical_cases": {
          "title": "Critical Cases",
          "type": "integer"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "format": {
          "const": "agentsec-scoring-replay-suite",
          "title": "Format",
          "type": "string"
        },
        "format_version": {
          "const": "0.1.0",
          "title": "Format Version",
          "type": "string"
        },
        "high_cases": {
          "title": "High Cases",
          "type": "integer"
        },
        "incomplete_coverage_cases": {
          "title": "Incomplete Coverage Cases",
          "type": "integer"
        },
        "medium_cases": {
          "title": "Medium Cases",
          "type": "integer"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suite Sha256",
          "type": "string"
        },
        "verified_against_frozen_replay": {
          "title": "Verified Against Frozen Replay",
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "format_version",
        "model_version",
        "suite_sha256",
        "file_sha256",
        "cases",
        "case_ids",
        "critical_cases",
        "high_cases",
        "medium_cases",
        "incomplete_coverage_cases",
        "verified_against_frozen_replay"
      ],
      "title": "ScoreReplayCalibration",
      "type": "object"
    }
