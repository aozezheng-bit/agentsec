{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.local/schemas/calibration/joint-expert-review-evidence.schema.json",
  "title": "JointExpertReviewEvidence",
  "description": "Pilot-only consensus evidence produced by experts reviewing together. It is not independent reviewer evidence and cannot qualify a Hard Gate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agentsec-joint-expert-review-evidence"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^joint-evidence-sha256:[0-9a-f]{64}$"
    },
    "joint_panel": {
      "$ref": "#/$defs/JointPanel"
    },
    "question_set_reviewer_id": {
      "enum": ["reviewer-a", "reviewer-b"]
    },
    "pack_id": {
      "type": "string",
      "pattern": "^reviewer-pack-sha256:[0-9a-f]{64}$"
    },
    "corpus_binding_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pilot_selection_id": {
      "type": "string",
      "pattern": "^pilot-selection-sha256:[0-9a-f]{64}$"
    },
    "reviewed_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/JointReviewRow"
      }
    },
    "boundary": {
      "$ref": "#/$defs/PilotOnlyBoundary"
    }
  },
  "required": [
    "format",
    "schema_version",
    "evidence_id",
    "joint_panel",
    "question_set_reviewer_id",
    "pack_id",
    "corpus_binding_hash",
    "pilot_selection_id",
    "reviewed_count",
    "reviews",
    "boundary"
  ],
  "$defs": {
    "JointPanel": {
      "title": "JointPanel",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_mode": {
          "const": "joint_expert_review"
        },
        "review_panel_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "independent_initial_labels": {
          "const": false
        },
        "adjudication_required": {
          "const": false
        },
        "qualification": {
          "const": "pilot_only"
        }
      },
      "required": [
        "evidence_mode",
        "review_panel_id",
        "reviewer_count",
        "independent_initial_labels",
        "adjudication_required",
        "qualification"
      ]
    },
    "EvidenceLocation": {
      "title": "EvidenceLocation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["path", "start_line", "end_line"]
    },
    "JointReviewRow": {
      "title": "JointReviewRow",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "standard",
            "policy_accepted_risk",
            "out_of_scope",
            "runtime_uncertainty",
            "unresolved"
          ]
        },
        "classification": {
          "type": ["null"]
        },
        "confidence": {
          "enum": ["A", "B", "C", "D"]
        },
        "corpus_binding_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "correlation": {
          "enum": [
            "same_target",
            "parent_child",
            "same_source",
            "explicit_relation",
            "agent_wide",
            "incomplete_coverage"
          ]
        },
        "disposition": {
          "enum": ["keep", "tune", "shadow", "retire", "more_data"]
        },
        "evidence_locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/EvidenceLocation"
          }
        },
        "finding_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "human_condition_label": {
          "enum": ["match", "no_match", "uncertain"]
        },
        "observed_finding": {
          "enum": ["present", "absent", "uncertain"]
        },
        "pack_id": {
          "type": "string",
          "pattern": "^reviewer-pack-sha256:[0-9a-f]{64}$"
        },
        "question_set_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rationale_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
        },
        "review_case_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "review_case_id": {
          "type": "string",
          "pattern": "^review-case-[0-9a-f]{20}$"
        },
        "review_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^review:reviewer-(a|b):review-case-[0-9a-f]{20}:[A-Za-z0-9._:-]+$"
        },
        "review_notes": {
          "type": "string",
          "maxLength": 2000
        },
        "reviewer_id": {
          "enum": ["reviewer-a", "reviewer-b"]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "const": "reviewed"
        }
      },
      "required": [
        "category",
        "classification",
        "confidence",
        "corpus_binding_hash",
        "correlation",
        "disposition",
        "evidence_locations",
        "finding_summary",
        "human_condition_label",
        "observed_finding",
        "pack_id",
        "question_set_sha256",
        "rationale_code",
        "review_case_fingerprint",
        "review_case_id",
        "review_id",
        "review_notes",
        "reviewer_id",
        "rule_id",
        "source_sha256",
        "status"
      ]
    },
    "PilotOnlyBoundary": {
      "title": "PilotOnlyBoundary",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formal_human_evidence": {"const": false},
        "p2_cal_04_human_evidence": {"const": false},
        "reviewer_independence": {"const": false},
        "reviewer_agreement_computable": {"const": false},
        "hard_gate_qualification": {"const": false},
        "ci_blocking": {"const": false},
        "fail_on": {"const": false}
      },
      "required": [
        "formal_human_evidence",
        "p2_cal_04_human_evidence",
        "reviewer_independence",
        "reviewer_agreement_computable",
        "hard_gate_qualification",
        "ci_blocking",
        "fail_on"
      ]
    }
  },
  "x-agentsec-joint-expert-review-evidence-schema-version": "0.1.0"
}
