{
  "$defs": {
    "CapabilityCorrelation": {
      "description": "Strength and scope of the deterministic fact correlation.",
      "enum": [
        "same_target",
        "parent_child",
        "same_source",
        "explicit_relation",
        "agent_wide",
        "incomplete_coverage"
      ],
      "title": "CapabilityCorrelation",
      "type": "string"
    },
    "ConfidenceReviewLabel": {
      "additionalProperties": false,
      "description": "One reviewer label for one expected deterministic Finding.",
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/EvidenceConfidence"
        },
        "correlation": {
          "$ref": "#/$defs/CapabilityCorrelation"
        },
        "rationale_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rationale Code",
          "type": "string"
        },
        "review_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Review Id",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConfidenceReviewStatus"
        }
      },
      "required": [
        "review_id",
        "case_id",
        "rule_id",
        "reviewer_id",
        "confidence",
        "correlation",
        "status",
        "rationale_code"
      ],
      "title": "ConfidenceReviewLabel",
      "type": "object"
    },
    "ConfidenceReviewStatus": {
      "enum": [
        "seeded",
        "reviewed",
        "adjudicated"
      ],
      "title": "ConfidenceReviewStatus",
      "type": "string"
    },
    "EvidenceConfidence": {
      "description": "Confidence in evidence, independent from finding severity.",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "EvidenceConfidence",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned, deterministic reviewer-label collection.",
  "properties": {
    "corpus_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Corpus Id",
      "type": "string"
    },
    "format": {
      "const": "agentsec-capability-confidence-review-set",
      "default": "agentsec-capability-confidence-review-set",
      "title": "Format",
      "type": "string"
    },
    "labels_version": {
      "minLength": 1,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Labels Version",
      "type": "string"
    },
    "reviewer_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reviewer Ids",
      "type": "array"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/ConfidenceReviewLabel"
      },
      "title": "Reviews",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "minLength": 1,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "labels_version",
    "reviewer_ids",
    "reviews"
  ],
  "title": "ConfidenceReviewSet",
  "type": "object",
  "x-agentsec-confidence-review-schema-version": "0.1.0"
}
