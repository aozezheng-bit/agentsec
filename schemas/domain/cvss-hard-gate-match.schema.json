{
  "additionalProperties": false,
  "description": "One deterministic CVSS threshold match in report-only mode.",
  "properties": {
    "floor": {
      "enum": [
        "high",
        "critical"
      ],
      "title": "Floor",
      "type": "string"
    },
    "gate_id": {
      "pattern": "^HG-CVSS-[0-9]{3}$",
      "title": "Gate Id",
      "type": "string"
    },
    "rationale": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Rationale",
      "type": "array"
    },
    "score": {
      "maximum": 10,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "score_type": {
      "enum": [
        "base",
        "temporal",
        "environmental",
        "threat",
        "environmental_threat"
      ],
      "title": "Score Type",
      "type": "string"
    },
    "threshold": {
      "maximum": 10,
      "minimum": 0,
      "title": "Threshold",
      "type": "number"
    }
  },
  "required": [
    "gate_id",
    "floor",
    "threshold",
    "score",
    "score_type",
    "rationale"
  ],
  "title": "CvssHardGateMatch",
  "type": "object"
}
