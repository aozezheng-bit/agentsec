{
  "$defs": {
    "ExternalPilotReviewCase": {
      "additionalProperties": false,
      "description": "One draft or completed independently reviewed Pilot label.",
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "expected_coverage": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "incomplete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Coverage"
        },
        "expected_exit": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Exit"
        },
        "expected_rule_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Rule Ids"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "case_id"
      ],
      "title": "ExternalPilotReviewCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Blinded independent-review submission bound to one reviewer pack.",
  "properties": {
    "case_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Manifest Sha256",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ExternalPilotReviewCase"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "format": {
      "const": "agentsec-external-pilot-review-submission",
      "title": "Format",
      "type": "string"
    },
    "independence_statement": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Independence Statement"
    },
    "pilot_id": {
      "pattern": "^[a-z][a-z0-9._-]{0,127}$",
      "title": "Pilot Id",
      "type": "string"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Id"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "complete"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "format",
    "schema_version",
    "status",
    "pilot_id",
    "case_manifest_sha256",
    "cases"
  ],
  "title": "ExternalPilotReviewSubmission",
  "type": "object"
}
