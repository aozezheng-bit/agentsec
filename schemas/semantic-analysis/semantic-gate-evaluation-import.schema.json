{
  "$defs": {
    "SemanticEvaluationCaseResult": {
      "additionalProperties": false,
      "description": "Value-free result for one case, with no raw model output.",
      "properties": {
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_comparisons": {
          "minimum": 0,
          "title": "Evidence Comparisons",
          "type": "integer"
        },
        "evidence_exact_matches": {
          "minimum": 0,
          "title": "Evidence Exact Matches",
          "type": "integer"
        },
        "expected_count": {
          "minimum": 0,
          "title": "Expected Count",
          "type": "integer"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "invocation_success": {
          "default": false,
          "title": "Invocation Success",
          "type": "boolean"
        },
        "predicted_count": {
          "minimum": 0,
          "title": "Predicted Count",
          "type": "integer"
        },
        "semantic_complete": {
          "default": false,
          "title": "Semantic Complete",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/SemanticEvaluationCaseStatus"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "status",
        "expected_count",
        "predicted_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "evidence_exact_matches",
        "evidence_comparisons"
      ],
      "title": "SemanticEvaluationCaseResult",
      "type": "object"
    },
    "SemanticEvaluationCaseStatus": {
      "enum": [
        "complete",
        "failed"
      ],
      "title": "SemanticEvaluationCaseStatus",
      "type": "string"
    },
    "SemanticEvaluationMetrics": {
      "additionalProperties": false,
      "description": "Deterministic semantic and Evidence quality metrics.",
      "properties": {
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "complete_coverage_cases": {
          "minimum": 0,
          "title": "Complete Coverage Cases",
          "type": "integer"
        },
        "complete_coverage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Complete Coverage Rate",
          "type": "number"
        },
        "completed_case_count": {
          "minimum": 0,
          "title": "Completed Case Count",
          "type": "integer"
        },
        "evidence_binding_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Binding Accuracy",
          "type": "number"
        },
        "evidence_comparisons": {
          "minimum": 0,
          "title": "Evidence Comparisons",
          "type": "integer"
        },
        "evidence_exact_matches": {
          "minimum": 0,
          "title": "Evidence Exact Matches",
          "type": "integer"
        },
        "f1": {
          "maximum": 1,
          "minimum": 0,
          "title": "F1",
          "type": "number"
        },
        "failed_case_count": {
          "minimum": 0,
          "title": "Failed Case Count",
          "type": "integer"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall",
          "type": "number"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "case_count",
        "completed_case_count",
        "failed_case_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "precision",
        "recall",
        "f1",
        "evidence_exact_matches",
        "evidence_comparisons",
        "evidence_binding_accuracy",
        "complete_coverage_cases",
        "complete_coverage_rate"
      ],
      "title": "SemanticEvaluationMetrics",
      "type": "object"
    },
    "SemanticEvaluationReport": {
      "additionalProperties": false,
      "description": "Machine-readable Shadow evaluation report; no enforcement decision.",
      "properties": {
        "cases": {
          "items": {
            "$ref": "#/$defs/SemanticEvaluationCaseResult"
          },
          "maxItems": 256,
          "title": "Cases",
          "type": "array"
        },
        "format": {
          "const": "agentsec-semantic-evaluation-report",
          "default": "agentsec-semantic-evaluation-report",
          "title": "Format",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/SemanticEvaluationMetrics"
        },
        "model_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "policy_authority": {
          "const": false,
          "default": false,
          "title": "Policy Authority",
          "type": "boolean"
        },
        "provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "release_authority": {
          "const": false,
          "default": false,
          "title": "Release Authority",
          "type": "boolean"
        },
        "report_only": {
          "const": true,
          "default": true,
          "title": "Report Only",
          "type": "boolean"
        },
        "runtime_verified": {
          "const": false,
          "default": false,
          "title": "Runtime Verified",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "model_id",
        "cases",
        "metrics"
      ],
      "title": "SemanticEvaluationReport",
      "type": "object"
    },
    "SemanticGateEvaluationSource": {
      "enum": [
        "evaluation_report",
        "real_provider_pilot"
      ],
      "title": "SemanticGateEvaluationSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A current, bound Provider evaluation accepted by P3-18.",
  "properties": {
    "candidate_id": {
      "pattern": "^semantic-gate-candidate-sha256:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "ci_authority": {
      "const": false,
      "default": false,
      "title": "Ci Authority",
      "type": "boolean"
    },
    "corpus_id": {
      "pattern": "^semantic-gate-human-corpus-sha256:[0-9a-f]{64}$",
      "title": "Corpus Id",
      "type": "string"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Sha256",
      "type": "string"
    },
    "evaluation": {
      "$ref": "#/$defs/SemanticEvaluationReport"
    },
    "evaluation_import_id": {
      "pattern": "^semantic-gate-evaluation-import-sha256:[0-9a-f]{64}$",
      "title": "Evaluation Import Id",
      "type": "string"
    },
    "evaluation_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Report Sha256",
      "type": "string"
    },
    "format": {
      "const": "agentsec-semantic-gate-evaluation-import",
      "default": "agentsec-semantic-gate-evaluation-import",
      "title": "Format",
      "type": "string"
    },
    "gate_id": {
      "pattern": "^SG-[A-Z0-9][A-Z0-9._-]{2,63}$",
      "title": "Gate Id",
      "type": "string"
    },
    "human_reviewer_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Human Reviewer Ids",
      "type": "array"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Schema Sha256",
      "type": "string"
    },
    "policy_authority": {
      "const": false,
      "default": false,
      "title": "Policy Authority",
      "type": "boolean"
    },
    "prompt_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Contract Sha256",
      "type": "string"
    },
    "prompt_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Prompt Version",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "release_authority": {
      "const": false,
      "default": false,
      "title": "Release Authority",
      "type": "boolean"
    },
    "report_only": {
      "const": true,
      "default": true,
      "title": "Report Only",
      "type": "boolean"
    },
    "rule_authority": {
      "const": false,
      "default": false,
      "title": "Rule Authority",
      "type": "boolean"
    },
    "runtime_verified": {
      "const": false,
      "default": false,
      "title": "Runtime Verified",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shadow_only": {
      "const": true,
      "default": true,
      "title": "Shadow Only",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/SemanticGateEvaluationSource"
    },
    "system_prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "System Prompt Sha256",
      "type": "string"
    }
  },
  "required": [
    "evaluation_import_id",
    "gate_id",
    "candidate_id",
    "corpus_id",
    "corpus_sha256",
    "evaluation_report_sha256",
    "provider_id",
    "model_id",
    "system_prompt_sha256",
    "output_schema_sha256",
    "prompt_contract_sha256",
    "human_reviewer_ids",
    "source",
    "evaluation"
  ],
  "title": "SemanticGateEvaluationImport",
  "type": "object"
}
