{
  "additionalProperties": false,
  "description": "Untrusted bounded Provider response retained only for contract validation.",
  "properties": {
    "completion_status": {
      "enum": [
        "complete",
        "length",
        "content_filter",
        "error"
      ],
      "title": "Completion Status",
      "type": "string"
    },
    "cost_microunits": {
      "default": 0,
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Cost Microunits",
      "type": "integer"
    },
    "format": {
      "const": "agentsec-semantic-provider-response",
      "default": "agentsec-semantic-provider-response",
      "title": "Format",
      "type": "string"
    },
    "input_tokens": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$",
      "title": "Model Id",
      "type": "string"
    },
    "output_json": {
      "maxLength": 131072,
      "minLength": 1,
      "title": "Output Json",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Sha256",
      "type": "string"
    },
    "output_tokens": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$",
      "title": "Provider Id",
      "type": "string"
    },
    "raw_response_retained": {
      "const": false,
      "default": false,
      "title": "Raw Response Retained",
      "type": "boolean"
    },
    "request_id": {
      "pattern": "^semantic-provider-request-sha256:[0-9a-f]{64}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "provider_id",
    "model_id",
    "completion_status",
    "output_json",
    "output_sha256",
    "input_tokens",
    "output_tokens"
  ],
  "title": "SemanticProviderResponse",
  "type": "object"
}
