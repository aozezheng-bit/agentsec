{
  "$defs": {
    "SemanticCandidateDisposition": {
      "description": "Probabilistic support state without enforcement meaning.",
      "enum": [
        "supported",
        "not_supported",
        "uncertain"
      ],
      "title": "SemanticCandidateDisposition",
      "type": "string"
    },
    "SemanticCandidateKind": {
      "description": "Bounded semantic judgment families; none is a published Finding.",
      "enum": [
        "capability_declaration",
        "control_weakening",
        "semantic_conflict",
        "cross_file_chain",
        "risky_intent",
        "ambiguity"
      ],
      "title": "SemanticCandidateKind",
      "type": "string"
    },
    "SemanticEvaluationExpected": {
      "additionalProperties": false,
      "description": "Gold semantic judgment with Evidence binding supplied by a reviewer.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/SemanticCandidateDisposition"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "judgment_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Judgment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemanticCandidateKind"
        }
      },
      "required": [
        "judgment_id",
        "kind",
        "category",
        "disposition",
        "evidence_ids"
      ],
      "title": "SemanticEvaluationExpected",
      "type": "object"
    },
    "SemanticGateCaseClass": {
      "description": "Gate-oriented class used for coverage accounting.",
      "enum": [
        "positive",
        "eligible_negative",
        "near_miss",
        "unknown"
      ],
      "title": "SemanticGateCaseClass",
      "type": "string"
    },
    "SemanticGateReviewDecision": {
      "additionalProperties": false,
      "description": "One independent review row; it contains no raw source text.",
      "properties": {
        "case_class": {
          "$ref": "#/$defs/SemanticGateCaseClass"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "confidence_grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "title": "Confidence Grade",
          "type": "string"
        },
        "expected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SemanticEvaluationExpected"
          },
          "title": "Expected",
          "type": "array"
        },
        "expected_gate_match": {
          "title": "Expected Gate Match",
          "type": "boolean"
        },
        "rationale_code": {
          "pattern": "^[a-z][a-z0-9._-]{1,63}$",
          "title": "Rationale Code",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_class",
        "expected_gate_match",
        "confidence_grade",
        "rationale_code"
      ],
      "title": "SemanticGateReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent reviewer submission to be imported after review.",
  "properties": {
    "corpus_id": {
      "pattern": "^semantic-gate-human-corpus-sha256:[0-9a-f]{64}$",
      "title": "Corpus Id",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/SemanticGateReviewDecision"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "format": {
      "const": "agentsec-semantic-gate-review-submission",
      "default": "agentsec-semantic-gate-review-submission",
      "title": "Format",
      "type": "string"
    },
    "gate_id": {
      "pattern": "^SG-[A-Z0-9][A-Z0-9._-]{2,63}$",
      "title": "Gate Id",
      "type": "string"
    },
    "independence_statement": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Independence Statement",
      "type": "string"
    },
    "independent": {
      "const": true,
      "default": true,
      "title": "Independent",
      "type": "boolean"
    },
    "reviewed_at": {
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "gate_id",
    "reviewer_id",
    "independence_statement",
    "reviewed_at",
    "decisions"
  ],
  "title": "SemanticGateReviewSubmission",
  "type": "object"
}
