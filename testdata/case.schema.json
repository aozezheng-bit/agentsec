{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.local/schemas/test-case.schema.json",
  "title": "AgentSec Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "category",
    "purpose",
    "assets",
    "expected"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "safe",
        "risky",
        "prompt-injection",
        "malformed"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "signals",
        "rule_ids"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[A-Z][A-Z0-9]*-[0-9]{3}$"
          }
        }
      }
    }
  }
}
