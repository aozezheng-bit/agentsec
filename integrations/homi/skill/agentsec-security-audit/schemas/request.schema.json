{
  "$id": "https://agentsec.local/schemas/homi-skill-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "snapshot",
              "drift",
              "risk"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "subject_id"
        ]
      }
    }
  ],
  "properties": {
    "baseline": {
      "description": "Atomic Snapshot 0.3 baseline path for Snapshot/Drift/Risk operations; must include subject and context summaries.",
      "maxLength": 4096,
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "default": "zh",
      "enum": [
        "zh",
        "en"
      ],
      "type": "string"
    },
    "operation": {
      "default": "scan",
      "enum": [
        "scan",
        "report",
        "capability",
        "diff",
        "score",
        "attack-graph",
        "snapshot",
        "drift",
        "risk"
      ],
      "type": "string"
    },
    "output_format": {
      "default": "json",
      "enum": [
        "json",
        "text",
        "html",
        "sarif"
      ],
      "type": "string"
    },
    "subject_id": {
      "default": null,
      "description": "Platform-owned stable Agent identifier required for Snapshot, Drift, and unified Risk.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": [
        "string",
        "null"
      ]
    },
    "workspace": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "workspace"
  ],
  "title": "AgentSec Homi Skill Request",
  "type": "object"
}
